{
  "name": "UijeongBoo Framework",
  "version": "1.0.0",
  "description": "Lightweight CSS framework for MCP local services",
  "designSystem": {
    "colors": {
      "primary": "#32CD32",
      "backgrounds": {
        "primary": "#222222",
        "secondary": "#333333",
        "tertiary": "#444444"
      },
      "text": {
        "primary": "#eeeeee",
        "secondary": "#cccccc",
        "muted": "#999999"
      },
      "borders": {
        "default": "#555555",
        "light": "#666666",
        "dark": "#444444"
      }
    },
    "spacing": {
      "xs": "4px",
      "sm": "8px",
      "md": "16px",
      "lg": "24px",
      "xl": "32px",
      "2xl": "48px"
    },
    "borderRadius": {
      "sm": "4px",
      "md": "8px",
      "lg": "12px",
      "full": "9999px"
    },
    "transitions": {
      "fast": "150ms ease",
      "base": "300ms ease",
      "slow": "500ms ease"
    }
  },
  "rules": {
    "enforceTransparentButtons": true,
    "forbidShadows": true,
    "forbidGradients": true,
    "enforceTextOverflow": true,
    "darkThemeOnly": true,
    "strictColorPalette": true
  },
  "components": [
    "buttons",
    "cards",
    "forms",
    "navigation",
    "modals",
    "tables"
  ],
  "utilities": {
    "layout": ["container", "flex", "grid"],
    "spacing": ["padding", "margin", "gap"],
    "typography": ["size", "weight", "alignment"],
    "colors": ["background", "text", "border"],
    "effects": ["transitions", "transforms", "water-text"]
  },
  "performance": {
    "minifiedSize": "< 15KB",
    "gzippedSize": "< 5KB",
    "cssVariables": true,
    "gpuAcceleration": true,
    "lazyLoading": false
  },
  "compatibility": {
    "browsers": ["> 1%", "last 2 versions", "not dead"],
    "prefixes": ["webkit", "moz"],
    "fallbacks": true
  },
  "mcp": {
    "optimized": true,
    "localFirst": true,
    "zeroNetwork": true,
    "memoryEfficient": true
  }
}