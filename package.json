{
  "name": "uijeongboo",
  "version": "2.0.0",
  "description": "Complete Tailwind alternative - Grayscale + 1 Primary Color. No Shadows. Transparent Buttons.",
  "main": "uijeongboo.min.css",
  "style": "uijeongboo.min.css",
  "scripts": {
    "build": "cat uijeongboo.css.backup | sed 's/\\[onclick\\]//g' | sed 's/htm /html /g' | sed 's/o /ol /g' > uijeongboo-bugfix.css && cat uijeongboo-bugfix.css NEW-UTILITIES.css > uijeongboo-v2.css",
    "minify": "postcss uijeongboo-v2.css --use autoprefixer cssnano -o uijeongboo.min.css",
    "build:full": "npm run build && npm run minify",
    "validate": "./validate-uijeongboo.sh",
    "watch": "chokidar 'css/**/*.css' -c 'npm run build:full'",
    "serve": "http-server -p 8080 -c-1",
    "audit": "node js/utils/enforcer-cli.js audit",
    "fix": "node js/utils/enforcer-cli.js fix",
    "check-colors": "node js/utils/enforcer-cli.js check-colors",
    "enforce-buttons": "node js/utils/enforcer-cli.js enforce-buttons"
  },
  "keywords": [
    "css",
    "framework",
    "uijeongboo",
    "mcp",
    "lightweight",
    "tailwind-alternative",
    "utility-first",
    "performance"
  ],
  "author": "coreeeeaaaa (https://github.com/coreeeeaaaa)",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/coreeeeaaaa/uijeongboo.git"
  },
  "files": [
    "css/",
    "js/",
    "components/",
    "*.html",
    "*.md",
    "logos/"
  ],
  "devDependencies": {
    "autoprefixer": "^10.4.22",
    "chokidar": "^3.5.3",
    "chokidar-cli": "^3.0.0",
    "cssnano": "^6.1.2",
    "http-server": "^14.1.1",
    "postcss": "^8.4.31",
    "postcss-cli": "^10.1.0"
  },
  "engines": {
    "node": ">=14.0.0"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead"
  ],
  "uijeongboo": {
    "version": "1.0.0",
    "rules": {
      "enforceTransparentButtons": true,
      "allowOnlyLimeAccent": true,
      "forbidBoxShadows": true,
      "grayscaleOnly": true
    },
    "components": [
      "header",
      "sidebar",
      "buttons",
      "navigation",
      "forms"
    ],
    "modules": {
      "core": [
        "variables",
        "reset",
        "typography",
        "layout"
      ],
      "utilities": [
        "spacing",
        "colors"
      ]
    }
  }
}
