{
  "name": "uijeongboo",
  "version": "1.0.0",
  "description": "Lightweight CSS framework optimized for MCP local services - Alternative to Tailwind",
  "main": "uijeongboo.min.css",
  "style": "uijeongboo.min.css",
  "scripts": {
    "build": "node build.js",
    "minify": "postcss uijeongboo.css -o uijeongboo.min.css --use cssnano",
    "validate": "./validate-uijeongboo.sh",
    "watch": "chokidar 'css/**/*.css' -c 'npm run build'",
    "serve": "http-server -p 8080 -c-1",
    "audit": "node js/utils/enforcer-cli.js audit",
    "fix": "node js/utils/enforcer-cli.js fix",
    "check-colors": "node js/utils/enforcer-cli.js check-colors",
    "enforce-buttons": "node js/utils/enforcer-cli.js enforce-buttons"
  },
  "keywords": [
    "css",
    "framework",
    "uijeongboo",
    "mcp",
    "lightweight",
    "tailwind-alternative",
    "utility-first",
    "performance"
  ],
  "author": "UijeongBoo Framework",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/uijeongboo/design-framework.git"
  },
  "files": [
    "css/",
    "js/",
    "components/",
    "*.html",
    "*.md",
    "logos/"
  ],
  "dependencies": {},
  "devDependencies": {
    "chokidar": "^3.5.3",
    "cssnano": "^6.0.1",
    "postcss": "^8.4.31",
    "postcss-cli": "^10.1.0",
    "chokidar-cli": "^3.0.0",
    "http-server": "^14.1.1"
  },
  "engines": {
    "node": ">=14.0.0"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead"
  ],
  "uijeongboo": {
    "version": "1.0.0",
    "rules": {
      "enforceTransparentButtons": true,
      "allowOnlyLimeAccent": true,
      "forbidBoxShadows": true,
      "grayscaleOnly": true
    },
    "components": [
      "header",
      "sidebar",
      "buttons",
      "navigation",
      "forms"
    ],
    "modules": {
      "core": [
        "variables",
        "reset",
        "typography",
        "layout"
      ],
      "utilities": [
        "spacing",
        "colors"
      ]
    }
  }
}